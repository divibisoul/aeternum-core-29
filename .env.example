# Browser-safe Supabase settings. Use only publishable/anon keys here.
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional N07 unified backend. Browser-safe endpoint only; app tokens remain server-side.
VITE_N07_BACKEND_URL=http://localhost:8080

# Supabase Edge Function server-side configuration. Never expose these as VITE_* values.
N07_BACKEND_URL=http://localhost:8080
N07_APP_TOKEN=configure-server-side-only
