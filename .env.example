# Supabase (public client configuration)
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase server-side storage metadata (never expose the secret key to the browser)
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_STORAGE_TABLE=soul_storage_records

# Soul Mesh
SOUL_MESH_HMAC_SECRET=change-me-in-production
SOUL_MESH_TOKEN=change-me-in-production
SOUL_MESH_N02_URL=
SOUL_MESH_N03_URL=
SOUL_MESH_N04_URL=
SOUL_MESH_N05_URL=
SOUL_MESH_N06_URL=
VITE_MESH_GATEWAY_URL=

# AI provider (inject through CI/CD secrets; never commit real keys)
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_API_KEY=your_google_api_key

# Hybrid Supabase + IPFS storage
WEB3_STORAGE_TOKEN=your_web3_storage_token
WEB3_STORAGE_API_URL=https://api.web3.storage
WEB3_STORAGE_GATEWAY_URL=https://w3s.link/ipfs
